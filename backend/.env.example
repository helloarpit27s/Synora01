# ─── NVIDIA NIM ────────────────────────────────────────────────────────────
# One key covers the whole catalog on the OpenAI-compatible endpoint.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ids move. Confirm with:
#   curl -s $NIM_BASE_URL/models -H "Authorization: Bearer $NVIDIA_API_KEY" | jq '.data[].id'
NIM_MODEL_REASONING=nvidia/llama-3.3-nemotron-super-49b-v1
NIM_MODEL_LIGHT=meta/llama-3.1-8b-instruct
NIM_MODEL_VISION=meta/llama-3.2-90b-vision-instruct
NIM_MODEL_EMBED=nvidia/nv-embedqa-e5-v5
NIM_MODEL_RERANK=nvidia/llama-3.2-nv-rerankqa-1b-v2
NIM_MODEL_GUARD=nvidia/llama-3.1-nemoguard-8b-content-safety

# ─── behaviour ─────────────────────────────────────────────────────────────
NIM_MIN_INTERVAL_S=1.5      # client-side pacing between upstream calls
NIM_TIMEOUT_S=45
NIM_MAX_RETRIES=3
RAG_TOP_K=8
RAG_RERANK_TO=4
RAG_MIN_SCORE=0.15
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
